#!/bin/bash
# agent-feedback setup [--hooks] [--codex] [--pi]   links hooks and skill (--hooks also adds them to ~/.claude/settings.json,
#                                                   --codex sets up Codex: skill in ~/.agents/skills, hooks in ~/.codex/hooks.json,
#                                                   --pi sets up pi: skill in ~/.agents/skills, extension in ~/.pi/agent/extensions)
# agent-feedback unlink                             removes those links again
set -euo pipefail
D="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# Homebrew: link through opt/ so the links survive upgrades.
case "$D" in */Cellar/agent-feedback/*) D="$(cd "$D/../../../../opt/agent-feedback/libexec" && pwd)" ;; esac
HOME_DIR="$HOME/.claude/agent-feedback"
SETTINGS="$HOME/.claude/settings.json"
CODEX_HOOKS="$HOME/.codex/hooks.json"
PI_EXTENSION="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/extensions/agent-feedback.ts"

case "${1-}" in
  setup) shift ;;
  unlink)
    rm -f "$HOME/.claude/skills/feedback"
    [ -L "$HOME/.agents/skills/feedback" ] && rm -f "$HOME/.agents/skills/feedback"
    [ -L "$PI_EXTENSION" ] && rm -f "$PI_EXTENSION"
    rm -rf "$HOME_DIR/bin"
    echo "Links removed. Hook entries containing \"agent-feedback\" in $SETTINGS and $CODEX_HOOKS stay; delete them yourself."
    exit 0 ;;
  *) sed -n '2,5s/^# //p' "$0"; exit 1 ;;
esac
CLAUDE_HOOKS=false CODEX=false PI=false
for arg in "$@"; do
  case "$arg" in
    --hooks) CLAUDE_HOOKS=true ;;
    --codex) CODEX=true ;;
    --pi) PI=true ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

mkdir -p "$HOME_DIR/bin" "$HOME/.claude/skills"
for f in common.sh feedback-dir.sh feedback-hint.sh session.sh; do ln -sfn "$D/hooks/$f" "$HOME_DIR/bin/$f"; done
ln -sfn "$D/skills/feedback" "$HOME/.claude/skills/feedback"
[ -f "$HOME_DIR/config.json" ] || echo '{}' > "$HOME_DIR/config.json"
echo "Hooks: $HOME_DIR/bin  ·  Skill: ~/.claude/skills/feedback  ·  Settings: $HOME_DIR/config.json"

# hooks_for <agent>: hook entries in the format shared by Claude Code and Codex.
hooks_for() {
  jq -n --arg b '~/.claude/agent-feedback/bin' --arg a "$1" '{
    UserPromptSubmit: [{hooks: [
      {type: "command", command: ($b + "/session.sh update " + $a), timeout: 5},
      {type: "command", command: ($b + "/feedback-hint.sh"), timeout: 5}]}],
    SessionEnd: [{hooks: [{type: "command", command: ($b + "/session.sh end " + $a), timeout: 5}]}]
  }'
}

# add_hooks <file> <entries>: merges the entries under "hooks" unless agent-feedback is already in there.
add_hooks() {
  if [ -f "$1" ] && grep -q 'agent-feedback' "$1"; then
    echo "Hooks are already set up in $1."
    return
  fi
  mkdir -p "$(dirname "$1")"
  [ -f "$1" ] || echo '{}' > "$1"
  cp "$1" "$1.bak-agent-feedback"
  MERGED=$(jq --argjson add "$2" '
    .hooks //= {} |
    reduce ($add | keys[]) as $event (.; .hooks[$event] = ((.hooks[$event] // []) + $add[$event]))' "$1")
  # Write into the existing file so a symlink (e.g. into a dotfiles repo) is preserved.
  printf '%s\n' "$MERGED" > "$1"
  echo "Hooks added to $1 (backup: $1.bak-agent-feedback)."
}

if $CLAUDE_HOOKS; then
  add_hooks "$SETTINGS" "$(hooks_for claude)"
  echo "New Claude Code sessions will register from now on."
else
  echo
  echo "Still to add to $SETTINGS under \"hooks\" (or agent-feedback setup --hooks):"
  hooks_for claude
fi

if $CODEX; then
  mkdir -p "$HOME/.agents/skills"
  ln -sfn "$D/skills/feedback" "$HOME/.agents/skills/feedback"
  echo "Codex skill: ~/.agents/skills/feedback"
  add_hooks "$CODEX_HOOKS" "$(hooks_for codex)"
  echo "In Codex, run /hooks once and trust the agent-feedback hooks; new Codex sessions register after that."
fi

if $PI; then
  mkdir -p "$HOME/.agents/skills" "$(dirname "$PI_EXTENSION")"
  ln -sfn "$D/skills/feedback" "$HOME/.agents/skills/feedback"
  ln -sfn "$D/hooks/pi-extension.ts" "$PI_EXTENSION"
  echo "pi skill: ~/.agents/skills/feedback  ·  pi extension: $PI_EXTENSION"
  echo "Restart running pi sessions (or /reload); they register with the next prompt."
fi
